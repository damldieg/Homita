# Configuración de compilación del dashboard. Cópialo como homita.properties (git lo ignora) y rellénalo.

# URL del backend de Homita que usa la release. Obligatoria para compilar la release.
# Desde el corte de producción (2026-11-08) es la Edge Function de Supabase. El valor vive solo en
# ~/.homita/supabase.env (nunca en git); el fichero se genera con:
#   . ~/.homita/supabase.env
#   printf 'homita.baseUrl=https://%s.supabase.co/functions/v1/api\n' "$SUPABASE_PROJECT_REF" \
#     > apps/dashboard/homita.properties
homita.baseUrl=https://<ref>.supabase.co/functions/v1/api

# Precedencia: homita.properties > -Phomita.baseUrl > HOMITA_BASE_URL; un fichero viejo pisa el env.

# URL del backend para la versión debug. Por defecto, la Edge local (supabase start / functions
# serve, ver supabase/README.md) vista desde el emulador.
#homita.debugBaseUrl=http://10.0.2.2:54321/functions/v1/api/
