<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Info.plist del target ControlApp (GENERATE_INFOPLIST_FILE=YES completa CFBundle* etc.).
  Configuración inyectada desde Config.local/prod.xcconfig (baseConfiguration del proyecto, según Debug/Release) vía
  variables de build; AppConfig.load() lee estas claves en Bundle.main.
  Nota: INFOPLIST_KEY_* solo acepta claves conocidas por Xcode, por eso van aquí.
-->
<dict>
	<key>PlanifyBaseURL</key>
	<string>$(PLANIFY_BASE_URL)</string>
	<key>SupabaseURL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SupabaseAnonKey</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<!-- Enlaces profundos de widgets, Live Activity y notificaciones: homita://nueva-tarea, … -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lito.planify.control.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>homita</string>
			</array>
		</dict>
	</array>
	<!-- Live Activity de rutinas en la pantalla de bloqueo (sin push: se inicia desde la app). -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Refresco en segundo plano (avisos, widgets, Live Activity). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.lito.planify.control.ios.refresh</string>
	</array>
</dict>
</plist>
